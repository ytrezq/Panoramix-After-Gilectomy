+TEST_CASE("floor: a rising variable whose start reads a word the loop leaves is at least that start, read as it is") {
+    Fixture fx;
+    // uniswap's test contracts (round 4): the return's encoding - a header
+    // at p = mem[64], then a loop writing at v from p + 32 on. The word
+    // unknown but at least 160: v's floor from the word's (192) says
+    // nothing against p itself (p may be 400, the header at 400, v from
+    // 432); the start `mem[64] + 32`, read as it is, does - the body leaves
+    // the word, which its walk checks with that very floor. What was
+    // written at p is still known after the loop.
+    const std::string head =
+        "(setmem (range 64 32) (sized 32 160)) "
+        "(if (calldataload 100) {(setmem (range 64 32) (sized 32 (add 192 (mask_shl 7 5 0 (calldataload 132)))))} {}) "
+        "(setmem (range (mem (range 64 32)) 32) (sized 32 7)) ";
+    const std::string loop =
+        "(while (lt loop1 (mask_shl 4 0 0 (calldataload 36))) {(setmem (range loop2 32) (sized 32 loop1)) "
+        "(continue loopid1 [(setvar loop1 (add 1 loop1)) (setvar loop2 (add 32 loop2))])} "
+        "loopid1 [(setvar loop1 0) (setvar loop2 (add 32 (mem (range 64 32))))]) ";
