  "comments": {
    "dependencies": "hardhat-solhint and hardhat-prettier includes old versions, that's why specific dependencies are added",
    "hardhat": "Migrated to Hardhat 3.x - ESM-first, declarative config"
  },
  "types": "types/index.d.ts",
  "files": [
    "/contracts"
  ],
  "keywords": [
    "blockchain",
    "ethereum",
    "hardhat",
    "smart-contracts",
    "solidity",
    "rsk"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "prepare": "husky install",
    "clean": "rm -rf cache out artifacts",
    "compile": "npx hardhat build",
    "build": "npx hardhat build",
    "lint": "npm run lint:ts && npm run prettier:check",
    "lint:ts": "eslint \"**/*.{js,ts}\"",
    "lint-fix": "eslint --fix \"**/*.{js,ts}\"",
    "prettier": "prettier --config .prettierrc --write \"**/*.{js,json,md,sol,ts,yml}\"",
    "prettier:check": "prettier --config .prettierrc --check \"**/*.{js,json,md,sol,ts,yml}\"",
    "release": "standard-version",
    "test": "npx hardhat test solidity",
    "test:storage": "FOUNDRY_PROFILE=storage forge clean && FOUNDRY_PROFILE=storage forge build --force && FOUNDRY_PROFILE=storage forge test -vv",
    "test:fork:mainnet": "npx hardhat test solidity -vvv",
    "test:all": "npm run test && npm run test:storage",
    "merge-params": "node scripts/changers/multiCollateralUpgrade/merge-ignition-params.mjs",
    "deploy-rskTestnet": "npx hardhat ignition deploy ./ignition/modules/changers/multiCollateralUpgrade/FullMultiCollateralUpgrade.ts --network rskTestnet --parameters ./ignition/modules/changers/multiCollateralUpgrade/parameters/full-rskTestnet.json",
    "deploy-rskMainnet": "npx hardhat ignition deploy ./ignition/modules/changers/multiCollateralUpgrade/FullMultiCollateralUpgrade.ts --network rskMainnet --parameters ./ignition/modules/changers/multiCollateralUpgrade/parameters/full-rskMainnet.json",
    "verify:rskTestnet": "npx hardhat ignition verify --network rskTestnet",
    "verify:rskMainnet": "npx hardhat ignition verify --network rskMainnet chain-30",
    "tenderly-verify:rskTestnet": "npx hardhat run scripts/tenderly-verify.ts --network rskTestnet"
  },
  "pnpm": {
    "overrides": {
      "hardhat": "https://github.com/money-on-chain/hardhat/releases/download/v3.0.10-moc/hardhat-3.0.10.tgz",
