{
  "name": "@parallel/parallel-tokens",
  "version": "1.0.0",
  "description": "Parallel Tokens",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "ci:coverage": "forge coverage --report lcov --ir-minimum && yarn lcov:clean",
    "coverage": "FOUNDRY_PROFILE=dev forge coverage --ir-minimum --report lcov && lcov --remove lcov.info -o lcov.info \"tests/*\" \"node_modules/*\" && genhtml lcov.info -o coverage",
    "compile": "forge build && hardhat compile",
    "compile:dev": "FOUNDRY_PROFILE=dev forge build",
    "deploy": "bunx hardhat deploy",
    "deploy:bridgeableTokenP": "bunx hardhat lz:deploy --tags BridgeableTokenP",
    "deploy:fork": "forge script --skip test  --slow --fork-url fork --broadcast -vvvv",
    "generate": "FOUNDRY_PROFILE=dev forge script scripts/utils/GenerateSelectors.s.sol",
    "OApp:wire:mainnet": "bunx hardhat run lz:oapp:wire --oapp-config layerZero/mainnet/bridgeableTokenP.config.ts",
    "OApp:wire:testnet": "bunx hardhat lz:oapp:wire --oapp-config layerZero/testnet/bridgeableTokenP.config.ts",
    "gas": "FOUNDRY_PROFILE=dev bun run test --gas-report",
    "fork": "bash helpers/fork.sh",
    "run": "docker run -it --rm -v $(pwd):/app -w /app ghcr.io/foundry-rs/foundry sh",
    "script:fork": "FOUNDRY_PROFILE=dev forge script --skip test --fork-url fork --broadcast -vvvv",
    "test": "forge test -vvv --gas-report --no-match-path \"tests/invariants/**/*.sol\"",
    "test:invariant": "forge test -vvv --gas-report --match-path \"tests/invariants/**/*.sol\"",
    "lcov:clean": "lcov --remove lcov.info -o lcov.info 'tests/**' 'scripts/**' 'contracts/transmuter/configs/**' 'contracts/utils/**'",
    "lcov:generate-html": "genhtml lcov.info --output=coverage",
    "slither": "slither . --triage-mode",
    "size": "forge build --skip test --sizes",
    "prettier": "prettier --write '**/*.sol'",
    "lint": "bun run lint:check --fix",
    "lint:check": "solhint \"**/*.sol\"",
    "verify": "rocketh-verify etherscan"
  },
  "devDependencies": {
    "@layerzerolabs/lz-definitions": "^3.0.142",
    "@layerzerolabs/metadata-tools": "^3.0.2",
    "@layerzerolabs/test-devtools-evm-foundry": "^6.0.3",
    "@layerzerolabs/toolbox-hardhat": "^0.6.12",
    "@nomicfoundation/hardhat-keystore": "^3.0.2",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.1",
    "@nomicfoundation/hardhat-node-test-runner": "^3.0.4",
    "@nomicfoundation/hardhat-viem": "^3.0.0",
    "@rocketh/deploy": "^0.19.1",
    "@rocketh/doc": "^0.19.3",
    "@rocketh/export": "^0.19.10",
    "@rocketh/node": "^0.19.3",
    "@rocketh/proxy": "^0.19.4",
    "@rocketh/read-execute": "^0.19.0",
    "@rocketh/signer": "^0.19.0",
    "@rocketh/verifier": "^0.19.3",
    "@rocketh/viem": "^0.19.0",
    "@typechain/hardhat": "^9.1.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.9.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "forge-std": "github:foundry-rs/forge-std#v1.9.5",
    "fs": "^0.0.1-security",
    "fs-extra": "^11.3.2",
    "hardhat": "^3.0.9",
    "hardhat-deploy": "^2.0.1",
    "ldenv": "^0.3.14",
    "prettier": "^3.6.2",
    "prettier-plugin-solidity": "^1.4.3",
    "rocketh": "^0.19.3",
    "solhint": "^5.2.0",
    "solhint-plugin-prettier": "^0.1.0",
    "solidity-bytes-utils": "^0.8.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3",
    "viem": "^2.38.4"
  },
  "dependencies": {
    "@layerzerolabs/lz-evm-oapp-v2": "^3.0.142",
    "@layerzerolabs/lz-evm-sdk-v2": "^3.0.165",
    "@openzeppelin/contracts": "^5.4.0",
    "@openzeppelin/contracts-upgradeable": "5.4.0"
  }
}
