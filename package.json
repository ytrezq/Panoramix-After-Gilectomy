{
  "name": "main-sc-protocol-v2",
  "version": "1.0.13",
  "private": true,
  "homepage": "https://www.moneyonchain.com",
  "description": "Money on Chain V2 main smart contract protocol",
  "author": "MOC Investments Corp. 2020",
  "license": "AGPL-3.0",
  "dependencies": {
    "hardhat": "2.26.3",
    "hardhat-deploy": "0.14.0",
    "hardhat-storage-layout": "0.1.7",
    "solc": "0.8.24"
  },
  "devDependencies": {
    "@commitlint/cli": "17.6.3",
    "@commitlint/config-conventional": "17.6.3",
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "1.0.0",
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@nomicfoundation/hardhat-verify": "2.1.0",
    "@nomiclabs/hardhat-solhint": "4.0.1",
    "@openzeppelin/contracts": "4.9.3",
    "@openzeppelin/contracts-upgradeable": "4.9.3",
    "@openzeppelin/hardhat-upgrades": "3.9.0",
    "@openzeppelin/upgrades-core": "1.31.1",
    "@types/chai": "4.3.5",
    "@types/debug": "4.1.12",
    "@types/fs-extra": "11.0.4",
    "@types/memoizee": "0.4.11",
    "@types/node": "22.13.5",
    "@typescript-eslint/eslint-plugin": "5.59.7",
    "@typescript-eslint/parser": "5.59.7",
    "@uniswap/universal-router": "2.0.0",
    "@uniswap/swap-router-contracts": "1.3.1",
    "@uniswap/v4-core": "1.0.1",
    "@uniswap/v4-periphery": "1.0.1",
    "copyfiles": "2.4.1",
    "dotenv": "16.4.7",
    "eslint": "8.41.0",
    "eslint-config-prettier": "10.1.1",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-no-only-tests": "3.1.0",
    "eslint-plugin-prettier": "5.2.5",
    "ethers": "6.14.0",
    "hardhat-contract-sizer": "2.10.0",
    "hardhat-docgen": "1.3.0",
    "hardhat-erc1820": "0.1.0",
    "hardhat-preprocessor": "0.1.5",
    "hardhat-storage-layout-diff": "0.0.4",
    "husky": "8.0.3",
    "memoizee": "0.4.17",
    "prettier": "3.5.3",
    "prettier-plugin-solidity": "1.4.2",
    "solhint": "5.0.5",
    "solhint-plugin-prettier": "0.1.0",
    "solidity-coverage": "0.8.14",
    "standard-version": "9.5.0",
    "ts-node": "10.9.2",
    "typechain": "8.3.2",
    "typescript": "5.7.3"
  },
  "overrides": {
    "eth-gas-reporter": {
      "axios": "1.6.0"
    },
    "axios": {
      "follow-redirects": "1.15.11"
    }
  },
  "comments": {
    "dependencies": "hardhat-solhint and hardhat-prettier includes old versions, that's why specific dependencies are added",
    "upgrades-core": "TODO: this dep is fixed to v1.31.1 because of a TSC issue, follow https://github.com/OpenZeppelin/openzeppelin-upgrades/issues/976"
  },
  "types": "types/index.d.ts",
  "files": [
    "/contracts",
    "/export"
  ],
  "keywords": [
    "blockchain",
    "ethereum",
    "hardhat",
    "smart-contracts",
    "solidity",
    "rsk"
  ],
  "scripts": {
    "prepare": "husky install",
    "clean": "hardhat clean",
    "typechain": "TS_NODE_TRANSPILE_ONLY=true hardhat --config ./hardhat.base.config.ts typechain",
    "compile": "npm run typechain && hardhat compile",
    "compile-not-viair": "VIA_IR=false npm run typechain && VIA_IR=false hardhat compile",
    "coverage": "npm run clean && VIA_IR=true hardhat coverage --solcoverjs ./.solcover.js --temp artifacts --testfiles \"./test/**/*.ts\"",
    "lint": "npm run lint:sol && npm run lint:ts && npm run prettier:check",
    "lint:sol": "solhint --config .solhint.json --max-warnings 0 \"contracts/**/*.sol\"",
    "lint:ts": "eslint --config ./.eslintrc.yaml --ignore-path ./.eslintignore \"**/*.{js,ts}\"",
    "lint-fix": "eslint --fix --config ./.eslintrc.yaml --ignore-path ./.eslintignore \"**/*.{js,ts}\"",
    "prettier": "prettier --config .prettierrc --write \"**/*.{js,json,md,sol,ts,yml}\"",
    "prettier:check": "prettier --config .prettierrc --check \"**/*.{js,json,md,sol,ts,yml}\"",
    "release": "standard-version",
    "security": "docker run -it -v $(pwd):/home/ethsec/project trailofbits/eth-security-toolbox",
    "security-default": "echo \"solc-select install 0.8.24 && solc-select use 0.8.24 && cd project && slither --exclude-dependencies --exclude pragma,low-level-calls .\" | sudo docker run -i -v $(pwd):/home/ethsec/project trailofbits/eth-security-toolbox",
    "slither": "slither .",
    "size-contracts": "hardhat size-contracts",
    "docgen": "hardhat docgen",
    "test": "GAS_ESTIMATION=false hardhat test --typecheck",
    "test-parallel": "hardhat test --typecheck --parallel",
    "test-gas-estimation": "GAS_ESTIMATION=true hardhat test --typecheck --grep '/.*gas estimation.*/i'",
    "report:gas": "REPORT_GAS=true hardhat test",
    "storage-layout": "npx ts-node ./scripts/storage-layout.ts",
    "storage-layout-compare:MocCoreExpansion": "hardhat storage-layout-compare --a contracts/core/MocCore.sol:MocCore --b contracts/core/MocCoreExpansion.sol:MocCoreExpansion",
    "export": "rm -rf export/ && hardhat export-artifacts export/artifacts && rm -rf dist/ && tsc && npm run copy-dist",
    "copy-dist": "copyfiles -u 1 'dist/deploy/**/*.js' 'dist/scripts/**/*' export",
    "mythril": "myth analyze --solc-json mythril.config.json --execution-timeout 3600"
  },
  "packageManager": "pnpm@10.19.0+sha512.c9fc7236e92adf5c8af42fd5bf1612df99c2ceb62f27047032f4720b33f8eacdde311865e91c411f2774f618d82f320808ecb51718bfa82c060c4ba7c76a32b8"
}
